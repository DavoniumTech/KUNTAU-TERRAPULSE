# Secrets and local authentication — NEVER COMMIT
.env
.env.*
!.env.example
.netrc
.dodsrc
.earthaccess/
*credentials*
*token*
*.pem
*.key

# Python and editor files
__pycache__/
*.py[cod]
.venv/
venv/
.vscode/
.idea/

# Local/raw scientific data — keep on the data owner's computer
/data/raw/**
/data/processed/**
/data/processed/*
*.h5
*.hdf5
*.nc
*.aux.xml
*.tif
*.tiff
*.vrt

# Local caches and temporary outputs
.cache/
.cache_earthdata/
*.log
*.tmp
.DS_Store
Thumbs.db

# Local bundles; do not upload whole working archives by default
*KTP_DELIVERABLES_BUNDLE*.zip
*KTP_LOCAL_PROCESSING_PACK*.zip
